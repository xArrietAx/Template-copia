---
import CmsImage from "@/components/ui/CmsImage.astro";

const { content } = Astro.props

 const { title, desc, image } = content

---

<section class="min-h-[80vh] flex items-center justify-center px-6 py-20">
  <div class="w-full max-w-5xl text-center flex flex-col items-center">

    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-gray-900 leading-tight max-w-4xl">
      {title}
    </h1>

    <p class="mt-6 max-w-2xl text-base sm:text-lg md:text-xl leading-relaxed text-gray-600">
      {desc}
    </p>

    <CmsImage
      src={image}
      alt={title}
      class="mt-12 w-full object-cover rounded-2xl shadow-xl"
      width={950}
      height={500}
    />

  </div>
</section>