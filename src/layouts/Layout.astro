---
import "@/styles/app.css"
import Header from "@/components/layout/Header";
import Footer from "@/components/layout/Footer.astro";
import { Font } from "astro:assets";
import { SEO } from "astro-seo";
import site from "@/config/site.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, image, imageAlt, schema } = Astro.props;

const isHome = Astro.url.pathname === "/";

const pageDescription = description ?? site.seo.defaultDescription;
const pageImage = new URL(image ?? site.seo.ogImage, Astro.site).href;
const pageImageAlt = imageAlt ?? title ?? site.seo.defaultTitle;

// Solo redes/links con valor real entran al sameAs
const sameAs = Object.values(site.social).filter(Boolean);

const businessSchema = isHome
  ? {
      // Home: objeto completo del negocio
      "@type": site.business.type,
      "@id": `${site.url}/#organization`,
      name: site.name,
      image: pageImage,
      url: site.url,
      telephone: site.phone || undefined,
      email: site.email || undefined,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.streetAddress,
        addressLocality: site.address.addressLocality,
        addressRegion: site.address.addressRegion,
        postalCode: site.address.postalCode,
        addressCountry: site.address.addressCountry,
      },
      geo:
        site.business.geo.latitude && site.business.geo.longitude
          ? {
              "@type": "GeoCoordinates",
              latitude: site.business.geo.latitude,
              longitude: site.business.geo.longitude,
            }
          : undefined,
      areaServed: site.business.areaServed || undefined,
      priceRange: site.business.priceRange || undefined,
      openingHours: site.business.openingHours.length
        ? site.business.openingHours
        : undefined,
      sameAs: sameAs.length ? sameAs : undefined,
    }
  : {
      // Páginas internas: referencia liviana, citable por @id desde
      // un schema propio de la página (Service, ContactPage, etc.)
      "@type": site.business.type,
      "@id": `${site.url}/#organization`,
      name: site.name,
    };

// WebSite solo se declara una vez, en la home
const websiteSchema = isHome
  ? {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: site.name,
      publisher: { "@id": `${site.url}/#organization` },
    }
  : undefined;

const extraSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [businessSchema, websiteSchema, ...extraSchemas].filter(Boolean),
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <Font cssVariable="--font-" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      titleTemplate={site.seo.titleTemplate}
      titleDefault={site.seo.defaultTitle}
      description={pageDescription}
      canonical={new URL(Astro.url.pathname, Astro.site).href}
      openGraph={{
        basic: {
          title: title ?? site.seo.defaultTitle,
          type: "website",
          image: pageImage,
        },
        image: { alt: pageImageAlt },
        optional: {
          description: pageDescription,
          locale: site.seo.locale || undefined,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: site.seo.twitterHandle || undefined,
        title: title ?? site.seo.defaultTitle,
        description: pageDescription,
        image: pageImage,
        imageAlt: pageImageAlt,
      }}
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </head>
  <body>
    <Header client:load />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>